# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which can generally be ignored
*.pdb
*.lib
*.rsp

# Soroban / Stellar CLI artifacts
**/.soroban/
*.wasm

# Test snapshots (soroban snapshot directories)
**/test_snapshots/
**/__snapshots__/

# proptest failure-seed files
**/proptest-regressions/

# Editor / IDE files
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db

# Node.js (TypeScript SDK)
node_modules/
sdk/typescript/dist/
sdk/typescript/coverage/
sdk/typescript/*.tsbuildinfo

# Environment files with secrets
.env
.env.local
.env.*.local
