# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which can generally be ignored
*.pdb
*.lib
*.rsp

# Soroban / Wasm build artifacts
*.wasm
*.wasm.gz

# Soroban test snapshots (generated by the Soroban test harness — not source)
test_snapshots/
**/.soroban/

# proptest failure-seed files
**/proptest-regressions/

# IDE / editor
.vscode/*.log
*.swp
*.swo
*~
.DS_Store
.idea/

# Environment files with secrets
.env
.env.local
.env.*.local

# Node / TypeScript SDK build artifacts
sdk/typescript/node_modules/
sdk/typescript/dist/
sdk/typescript/coverage/
sdk/typescript/*.tsbuildinfo

# Misc local files
*.bak
*.orig
