# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which can generally be ignored
*.pdb
*.lib
*.rsp

# Soroban test snapshots — generated automatically during `cargo test`;
# committing them bloats history without adding correctness guarantees.
test_snapshots/
**/test_snapshots/

# proptest failure-seed files
**/proptest-regressions/

# Environment / secrets — never commit real keys or RPC URLs
.env
*.env
*.env.local
*.env.*.local

# IDE / editor directories
.idea/
.vscode/
*.swp
*.swo
*~

# macOS filesystem noise
.DS_Store
.AppleDouble
.LSOverride

# Node / TypeScript build artifacts (sdk/typescript)
node_modules/
dist/
build/
*.tsbuildinfo

# Coverage reports
coverage/
lcov.info
*.lcov

# WASM build outputs — regenerated by `cargo build --target wasm32v1-none`
*.wasm

# Stellar CLI key files — contain private keys
identity/
.stellar/

# Log files
*.log
npm-debug.log*

# Temporary files
*.tmp
*.temp
