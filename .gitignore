# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which can generally be ignored
*.pdb
*.lib
*.rsp

# Soroban test snapshots
test_snapshots/
# proptest failure-seed files
**/proptest-regressions/

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Editor and IDE files
.idea/
.vscode/*.log
*.swp
*.swo
*~
.project
.classpath
.settings/

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Node.js (sdk/typescript)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# WASM build artifacts (generated, not source)
*.wasm

# Soroban CLI artifacts
*.stellar
.soroban/

# Temporary and log files
*.log
*.tmp
*.temp
/tmp/
