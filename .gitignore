# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which can generally be ignored
*.pdb
*.lib
*.rsp

# Soroban test snapshots
test_snapshots/
**/test_snapshots/

# proptest failure-seed files
**/proptest-regressions/

# ── TypeScript SDK ────────────────────────────────────────────────────────────

# Build output
sdk/typescript/dist/

# Dependencies (committed lock file is kept; node_modules are not)
sdk/typescript/node_modules/

# Jest test snapshots
sdk/typescript/**/__snapshots__/
sdk/typescript/**/*.snap

# TypeScript build info caches
sdk/typescript/tsconfig.tsbuildinfo
sdk/typescript/*.tsbuildinfo

# ── Environment / Secrets ─────────────────────────────────────────────────────

# Local environment overrides (the committed .env.example is fine)
.env
.env.local
.env.*.local

# ── Editor / IDE ──────────────────────────────────────────────────────────────

# JetBrains IDEs (IntelliJ, CLion, etc.)
.idea/

# Vim swap / backup files
*.swp
*.swo
*~

# macOS filesystem metadata
.DS_Store

# Windows filesystem metadata
Thumbs.db
desktop.ini

# ── Misc generated files ──────────────────────────────────────────────────────

# Coverage reports
lcov.info
coverage/
*.profraw
*.profdata

# Compiled WASM artifacts placed outside target/ by custom scripts
*.wasm

# Log files
*.log
